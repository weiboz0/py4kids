# Secrets — NEVER commit (the repo is PUBLIC)
.gh-token
.env
.env.*
*.pem
*.key

# Student data — NEVER commit (the repo is PUBLIC)
student-data/
rosters/
grades/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Build artifacts
build/
*.pdf
# Every generated PDF is copied to output/<id>/ (plan 090); book editions are named
# <id>-<edition>.pdf (design 008). Only output/README.md is committed.
output/**/*.pdf

# unit-09 file-I/O runtime scratch (created by lesson/solution notebooks at run time; never commit)
python-projects/units/unit-09-save-point/savegame.txt
python-projects/units/unit-09-save-point/settings.txt
python-projects/units/unit-09-save-point/overwrite_scores_tmp.txt

# checkpoint-04 file-I/O runtime scratch (written by Q3, read by Q4 at run time; never commit)
python-projects/checkpoints/checkpoint-04-year-one-finale/finale.txt

# project-02 capstone file-I/O runtime scratch (written then read by the save/load milestone; never commit)
python-projects/projects/project-02-grand-adventure/adventure_save.txt
python-projects/units/unit-09-save-point/dragon_slot.txt

# Local agent session state
.claude/

# python-concepts U12/U13/cp05 file-I/O runtime scratch (written by lesson/exercise/solution/checkpoint
# notebooks at run time via self-contained setup; never commit)
python-concepts/units/unit-12-files/*.txt
python-concepts/units/unit-13-objects/*.txt
python-concepts/checkpoints/checkpoint-05-files-and-objects/*.txt
python-concepts/projects/project-01-algorithm-challenge/*.txt

# ACSL verify-cell evaluators (plan 094): verify cells import assets/verify/*.py, which writes bytecode
acsl/**/assets/verify/__pycache__/

# recsys (design 011): all generated / sliced data is REGENERATED-ONLY and never committed (the repo
# is PUBLIC; the real-catalog slice is license-gated). CI regenerates the seeded substrate each run
# and validates it; nothing here is tracked.
recsys/data/generated/

# The learning-website bundle (design 012; plan 101): generated by `py4kids-tools export`, never committed
site/content/
# The learning website's build (plan 103): dependencies and build output, never committed
site/node_modules/
site/dist/
site/.astro/
