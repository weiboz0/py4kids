---
/**
 * The book's quick reference `/<book>/reference/` (plan 103 Pages): its `reference_md`, rendered
 * with the site's Markdown pipeline. Indexed for search (`data-pagefind-body`). All bundle data
 * comes through referenceView (site/src/lib/book-page.ts).
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { getBooks, type LoadedBook } from '../../../lib/bundle';
import { hasReference, referenceView } from '../../../lib/book-page';

export const getStaticPaths = (() =>
  getBooks().filter(hasReference).map((book) => ({ params: { book: book.id }, props: { book } }))) satisfies GetStaticPaths;

interface Props {
  book: LoadedBook;
}
const { book } = Astro.props;
const view = referenceView(book);
---
<Base title={`Quick reference: ${view.bookTitle}`} description={`A one-page reminder of ${view.bookTitle}.`} book={book}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href={view.bookHref} data-pagefind-meta="book" data-pagefind-filter="book">{view.bookTitle}</a></nav>
  <article class="reference" data-pagefind-body>
    {!view.ownHeading && <h1>Quick reference</h1>}
    <Fragment set:html={view.html} />
  </article>
</Base>
