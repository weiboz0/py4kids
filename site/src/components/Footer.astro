---
interface Props {
  /** The release tag to show, if any (`unreleased` for a local build). */
  release?: string | undefined;
}
const { release } = Astro.props;
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <p>
      Course content by py4kids, licensed{' '}
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license">CC BY-NC-SA 4.0</a>.
    </p>
    <nav aria-label="Site">
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </nav>
    {release && <p>Release: {release}</p>}
  </div>
</footer>
