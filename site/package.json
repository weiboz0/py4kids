{
  "name": "py4kids-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "e2e": "playwright test --project site --project lighthouse",
    "e2e:solvers": "playwright test --project solvers-setup --project solvers --workers 4",
    "slide-audit": "node scripts/slide-audit.ts",
    "search-index": "node scripts/search-index.ts",
    "pwa-build": "node scripts/pwa-build.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@shikijs/transformers": "4.5.0",
    "ajv": "8.20.0",
    "astro": "7.3.7",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-container": "4.0.0",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
