{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://py4kids.local/runner/reply.schema.json",
  "title": "Runner reply (runner -> site)",
  "description": "Design 012 D7, plan 104: the only messages the site accepts from the runner. Validated on both sides (runner/src/envelope.ts is the hand-written twin; runner/test/envelope.test.ts proves they agree).",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/restarted" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "ms": { "type": "number", "minimum": 0 },
    "case": {
      "type": "object",
      "description": "One verdict: a fixture case, an assert (never its source) or a part of the turtle rule.",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "pass": { "type": "boolean" },
        "detail": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name", "pass", "detail"],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" },
        "color": { "type": "string", "maxLength": 100 },
        "width": { "type": "number" }
      },
      "required": ["x1", "y1", "x2", "y2", "color", "width"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "type": { "const": "result" },
        "id": { "$ref": "#/$defs/id" },
        "session": { "$ref": "#/$defs/id" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/case" }, "maxItems": 300 },
        "timing": {
          "type": "object",
          "properties": {
            "boot_ms": { "$ref": "#/$defs/ms" },
            "run_ms": { "$ref": "#/$defs/ms" },
            "restart_ms": { "$ref": "#/$defs/ms" }
          },
          "required": ["boot_ms", "run_ms", "restart_ms"],
          "additionalProperties": false
        },
        "status": {
          "enum": ["ok", "error", "timeout", "interrupted"],
          "description": "timeout: the budget ran out; interrupted: the Stop button."
        },
        "interrupts": {
          "enum": ["sab", "restart"],
          "description": "sab: the worker survived (SharedArrayBuffer interrupts work); restart: the worker was terminated and restarted (a lesson session is lost)."
        },
        "session_new": {
          "type": "boolean",
          "description": "The session had no state before this run (first run, or after a restart): replay the prelude."
        },
        "truncated": { "type": "boolean", "description": "stdout or stderr hit the size cap." },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" }, "maxItems": 10000 }
      },
      "required": ["type", "id", "session", "stdout", "stderr", "results", "timing", "status", "interrupts", "session_new", "truncated", "segments"],
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "description": "The answer to ping: Python is booted.",
      "properties": {
        "type": { "const": "ready" },
        "id": { "$ref": "#/$defs/id" },
        "python": { "type": "string", "maxLength": 200 },
        "pyodide": { "type": "string", "maxLength": 50 },
        "isolated": { "type": "boolean", "description": "crossOriginIsolated in the runner page and its worker." },
        "boot_ms": { "$ref": "#/$defs/ms" }
      },
      "required": ["type", "id", "python", "pyodide", "isolated", "boot_ms"],
      "additionalProperties": false
    },
    "restarted": {
      "type": "object",
      "description": "The answer to reset: the lesson worker was restarted, so every lesson session is empty.",
      "properties": {
        "type": { "const": "restarted" },
        "id": { "$ref": "#/$defs/id" },
        "boot_ms": { "$ref": "#/$defs/ms" }
      },
      "required": ["type", "id", "boot_ms"],
      "additionalProperties": false
    }
  }
}
